PORT=3300
NODE_ENV=production

# Used to build links in verification/reset emails. Set this to your real domain.
APP_URL=https://yourdomain.com

# Long random string — used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=changeme-generate-a-real-secret

# --- Email (optional) ---
# Leave these blank to run without email: new accounts auto-verify, and
# reminder/summary emails just get logged to the console instead of sent.
# Fill them in whenever you're ready and restart the server — verification
# and real email delivery turn on automatically, no code changes needed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Fretwork <no-reply@yourdomain.com>"
